{
  "name": "read-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "d1:migrate:local": "wrangler d1 migrations apply read-later-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply read-later-db --remote"
  },
  "devDependencies": {
    "eslint": "^9.31.0",
    "wrangler": "^4.114.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
